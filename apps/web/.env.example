NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Mock API is embedded in Next.js at localhost:3000/api/v1.
# API_UPSTREAM is used only after switching to api mode with an external backend.
API_UPSTREAM=http://localhost:3000
MOCK_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://[::1]:3000
